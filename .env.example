# Copy to cluster.env and edit before running scripts.
KUBERNETES_MINOR=1.32
KUBERNETES_VERSION=v1.32.0
CONTROL_PLANE_ENDPOINT=k8s-api.example.com:6443
POD_CIDR=192.168.0.0/16
SERVICE_CIDR=10.96.0.0/12
CNI_MANIFEST_URL=https://raw.githubusercontent.com/projectcalico/calico/v3.29.1/manifests/calico.yaml

# UniKube is the official Python CLI package. Pin a release in production.
UNIKUBE_VERSION=latest

# Set true only for a single-node development cluster.
ALLOW_DOWNTIME=false